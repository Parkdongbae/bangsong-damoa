rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 템플릿 첨부파일: 읽기 공개, 관리자만 쓰기(관리자 판정은 Firestore users.role 기준)
    match /templates/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
